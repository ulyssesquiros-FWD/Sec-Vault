# ==============================================================================
# SecureVault - Plantilla de Variables de Entorno
# ==============================================================================
# IMPORTANTE:
# 1. Nunca subas archivos .env reales a GitHub ni compartas secretos.
# 2. Copia este archivo como .env en desarrollo local y genera llaves reales:
#    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 3. En produccion, configura estas variables desde el gestor de secretos del PaaS.
# ==============================================================================

# --- Entorno de Aplicacion ---
NODE_ENV=development
PORT=4000
TRUST_PROXY=false

# URL publica de la aplicacion y origen CORS autorizado
APP_URL=http://localhost:5173
ALLOWED_ORIGIN=http://localhost:5173

# --- Base de Datos MySQL 8.0+ / 8.4 ---
# En produccion usar usuario de aplicacion con privilegios minimos (NUNCA root)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=securevault
DB_USER=securevault_app
DB_PASSWORD=
# En produccion DB_SSL debe ser true y DB_SSL_CA opcional si usa certificado CA custom
DB_SSL=false
DB_SSL_CA=
DB_CONNECTION_LIMIT=10

# --- Base de Datos de Pruebas (Independiente) ---
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3306
TEST_DB_NAME=securevault_test
TEST_DB_USER=securevault_test
TEST_DB_PASSWORD=

# --- Sesiones Seguras (express-session + express-mysql-session) ---
# Minimo 32 caracteres aleatorios (64 hex recomendados)
SESSION_SECRET=
SESSION_IDLE_TIMEOUT_MS=1800000
SESSION_ABSOLUTE_TIMEOUT_MS=43200000
COOKIE_SAME_SITE=lax

# --- Criptografia AES-256-GCM y bcrypt ---
# Exactamente 64 caracteres hexadecimales (32 bytes = 256 bits)
DATA_ENCRYPTION_KEY=
ENCRYPTION_KEY_VERSION=v1
# Opcional para rotacion progresiva sin perdida de datos: v0:<64hex>,v1:<64hex>
DATA_ENCRYPTION_PREVIOUS_KEYS=
# Costo minimo obligatorio: 12
BCRYPT_ROUNDS=12

# --- Correo SMTP (Nodemailer para recuperacion de contrasena y alertas) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SecureVault <no-reply@example.com>

# --- Alertas Externas de Seguridad (Opcional - Bonificacion 5) ---
# Solo HTTPS publico en produccion (protegido contra SSRF)
SECURITY_ALERT_WEBHOOK_URL=
SECURITY_ALERT_EMAIL=

# --- Seeder Inicial (Opcional - Solo si se ejecuta npm run db:seed) ---
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_PHONE=
